# Copy this file to .env and fill in your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ksrtc_vtms

# ETA/ETD tuning (real-time downstream stop prediction)
ETA_DWELL_SECONDS=20
ETA_MIN_MOVING_SPEED_KMH=12
ETA_MAX_DOWNSTREAM_STOPS=8

# Database timing logs (global)
DB_TIMING_ENABLED=true
DB_TIMING_MIN_MS=20
DB_TIMING_VERBOSE=false

# Whole-operation timing logs
SEED_OPERATION_LOG_MIN_MS=500
SIM_TICK_LOG_MIN_MS=100
PROCESS_EVENT_LOG_MIN_MS=50
