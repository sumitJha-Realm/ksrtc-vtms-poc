# Copy this file to .env and fill in your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ksrtc_vtms

# ETA/ETD tuning (real-time downstream stop prediction)
ETA_DWELL_SECONDS=20
ETA_MIN_MOVING_SPEED_KMH=12
ETA_MAX_DOWNSTREAM_STOPS=8
